# Parses every Skript event name and event filter MineSkript accepts. Event triggers are parsed but never run
# here, so a spelling that does not parse fails this file; the Java EventFiltersTest fires them.

on break of stone:
	stop
on mine of diamond ore or deepslate diamond ore:
	stop
on block breaking:
	stop
on place of torch:
	stop
on building:
	stop
on death of zombie:
	stop
on death of a wither or ender dragon:
	stop
on entity death of creeper:
	stop
on spawn of creeper:
	stop
on entity despawn of item:
	stop
on gamemode change to creative:
	stop
on game mode change:
	stop
on weather change to rain:
	stop
on weather change to sunny or thunderstorm:
	stop
on effect gain of speed:
	stop
on effect loss of night vision:
	stop
on consume of golden apple:
	stop
on player drinking:
	stop
on item break of diamond pickaxe:
	stop
on player tool breaking:
	stop
on sneak toggle:
	stop
on toggle sneak:
	stop
on sprint toggle:
	stop
on player toggling sprint:
	stop
on tool change:
	stop
on player's held item change:
	stop
on join:
	stop
on quit:
	stop
on player level change:
	stop
on level progress change:
	stop
on food bar change:
	stop
on player jump:
	stop
on player respawn:
	stop
on healing:
	stop
on mounting:
	stop
on dismounting:
	stop
on player world change:
	stop
on end item use:
	stop
on chunk loading:
	stop

test "the event filters parse":
	assert 1 is 1
